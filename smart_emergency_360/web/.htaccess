# Rescue One - Apache / LiteSpeed settings (Hostinger)

# Browsers only allow location access over HTTPS - always redirect to it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

DirectoryIndex index.html

# Correct types for Flutter web files.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/otf .otf
  AddType font/ttf .ttf
</IfModule>

# Compress text files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# The app's own files keep the same names between versions, so the
# browser must re-check them - otherwise visitors keep an old version
# after an update. Images/fonts can be cached for a week.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|json|wasm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|svg|ico|otf|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
